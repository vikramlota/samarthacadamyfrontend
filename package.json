{
  "name": "samarth-academy-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cross-env BUILD_TARGET=admin vite --open /admin/",
    "prebuild": "node scripts/pre-build.js",
    "build": "vite build && node scripts/generate-sitemap.js",
    "build:admin": "cross-env BUILD_TARGET=admin vite build",
    "build:all": "npm run build && npm run build:admin",
    "postbuild": "react-snap",
    "preview": "vite preview",
    "preview:admin": "cross-env BUILD_TARGET=admin vite preview --outDir dist-admin",
    "lint": "eslint .",
    "build:analyze": "vite-bundle-visualizer",
    "build:no-snap": "vite build && node scripts/generate-sitemap.js"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "include": [
      "/",
      "/about",
      "/faculty",
      "/contact",
      "/courses",
      "/blog",
      "/ssc-coaching-amritsar",
      "/bank-coaching-amritsar",
      "/psssb-coaching-amritsar",
      "/punjab-police-coaching-amritsar",
      "/ssc-cgl-coaching-amritsar",
      "/ibps-po-coaching-amritsar",
      "/ugc-net-coaching-amritsar",
      "/cat-coaching-amritsar",
      "/blog/category/ssc-tips",
      "/blog/category/banking-prep",
      "/blog/category/punjab-police-state",
      "/blog/category/exam-notifications",
      "/blog/category/career-guidance",
      "/blog/category/success-stories",
      "/blog/ssc-cgl-2026-notification-complete-guide-important-dates-3-month-strategy",
      "/blog/how-to-prepare-for-psssb-exam-2026-complete-strategy-guide"
    ],
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--window-size=1920,1080"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "inlineCss": false,
    "fixWebpackChunksIssue": "CRA2",
    "publicPath": "/",
    "removeStyleTags": false,
    "preloadImages": false,
    "concurrency": 1,
    "userAgent": "ReactSnap"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.16.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.0.0",
    "framer-motion": "^12.38.0",
    "jodit-react": "^5.3.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react-snap": "^1.23.0",
    "terser": "^5.46.2",
    "vite": "^7.2.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-purgecss": "^0.2.13"
  }
}
